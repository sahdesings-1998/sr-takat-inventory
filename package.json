{
  "name": "sr-takat",
  "private": true,
  "version": "1.0.0",
  "description": "SR TAKAT Gem & Jewellery Management System (MERN)",
  "scripts": {
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
